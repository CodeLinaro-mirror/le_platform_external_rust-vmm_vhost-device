[Unit]
Description=Service to start vhost-device-i2c daemon

After=remote-fs.target

Before=qcrosvm.service

[Service]
ExecStart=/usr/bin/vhost-device-i2c \
--socket-path=/tmp/linux-vm2-i2c-skt \
--socket-count=1 \
--device-list "9:67:75:79"

[Install]
WantedBy=multi-user.target

