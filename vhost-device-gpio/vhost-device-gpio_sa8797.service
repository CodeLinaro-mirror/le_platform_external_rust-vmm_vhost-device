[Unit]
Description = launch vhost-device-gpio for pmic gpiochip
After=tmp.mount
Before = qcrosvm.service shutdown.target
Conflicts=shutdown.target
DefaultDependencies=no

[Service]
Environment=RUST_LOG=info
ExecStart=/usr/bin/vhost-device-gpio \
--socket-path=/tmp/linux-vm2-gpio-skt \
--socket-count=1 \
--device-list "1"
Slice=gvm.slice

[Install]
WantedBy = single-gvm.target
WantedBy = multi-gvm.target
WantedBy = safe-ivi.target
WantedBy = nonsafe-ivi.target
WantedBy = flex.target
