[Unit]
Description = launch vhost-device-gpio for pmic gpiochip

Before = qcrosvm.service

[Service]
Environment=RUST_LOG=info
ExecStart=/usr/bin/vhost-device-gpio \
--socket-path=/tmp/linux-vm2-gpio-skt \
--socket-count=1 \
--device-list "1"
Slice=gvm.slice

[Install]
WantedBy=multi-user.target
