[Unit]
Description = launch vhost-device-ssr

After = ssr-rm.service tmp.mount
Requires = ssr-rm.service
Before = qcrosvm.service shutdown.target
Conflicts = shutdown.target
DefaultDependencies = no

[Service]
Environment=RUST_LOG=info
ExecStart = /usr/bin/vhost-device-ssr --socket-path=/tmp/linux-vm2-ssr-skt --clients-groups=CDSP,CDSP1 --enable-sd-notify -p "vhost-device-ssr-la"
Type=notify
NotifyAccess=main
Slice=gvm.slice

[Install]
WantedBy = multi-user.target
